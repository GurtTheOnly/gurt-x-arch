# Changes require a restart to take effect.

# Ensure Gurt bins are in the path
export GURT_PATH=$HOME/.local/share/gurt
export PATH=$GURT_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
gurt-cmd-present mise && eval "$(mise activate bash --shims)"
