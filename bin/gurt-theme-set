#!/bin/bash

# gurt:summary=Apply an Gurt theme
# gurt:args=<theme-name>
# gurt:examples=gurt theme list | gurt theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: gurt-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/gurt/current/theme"
NEXT_THEME_PATH="$HOME/.config/gurt/current/next-theme"
USER_THEMES_PATH="$HOME/.config/gurt/themes"
GURT_THEMES_PATH="$GURT_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $GURT_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$GURT_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  gurt-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
gurt-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/gurt/current/theme.name"

# Change background with theme
if [[ $GURT_THEME_SKIP_BACKGROUND != "1" ]]; then
  gurt-theme-bg-next
fi

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  gurt-restart-waybar
fi
gurt-restart-swayosd
gurt-restart-terminal
gurt-restart-hyprctl
gurt-restart-btop
gurt-restart-opencode
gurt-restart-mako
gurt-restart-helix

# Change app-specific themes
gurt-theme-set-foot
gurt-theme-set-gnome
gurt-theme-set-browser
gurt-theme-set-vscode
gurt-theme-set-obsidian
gurt-theme-set-keyboard

# Call hook on theme set
gurt-hook theme-set "$THEME_NAME" >/dev/null
