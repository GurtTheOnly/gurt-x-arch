#!/bin/bash

# gurt:summary=Set the Plymouth boot theme from an Gurt theme
# gurt:args=<theme-name>
# gurt:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via gurt-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: gurt-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/gurt/themes/$theme ]]; then
  theme_dir=~/.config/gurt/themes/$theme
else
  theme_dir="$GURT_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec gurt-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
