#!/bin/bash

# gurt:summary=Overwrite all the user configs in ~/.config/hypr with the Gurt defaults.

gurt-refresh-config hypr/autostart.conf
gurt-refresh-config hypr/bindings.conf
gurt-refresh-config hypr/input.conf
gurt-refresh-config hypr/looknfeel.conf
gurt-refresh-config hypr/hyprland.conf
gurt-refresh-config hypr/monitors.conf
bash "$GURT_PATH/install/config/detect-keyboard-layout.sh"
