#!/bin/bash

# gurt:summary=Run the full Gurt update pipeline
# gurt:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
gurt-update-keyring
gurt-update-available-reset
gurt-update-system-pkgs
gurt-migrate
gurt-update-aur-pkgs
gurt-update-orphan-pkgs
gurt-hook post-update

gurt-update-analyze-logs

gurt-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
