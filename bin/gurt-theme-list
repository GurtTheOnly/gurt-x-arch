#!/bin/bash

# gurt:summary=List available themes
# gurt:examples=gurt theme list | gurt theme set "Tokyo Night"

{
  find ~/.config/gurt/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$GURT_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
