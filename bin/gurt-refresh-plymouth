#!/bin/bash

# gurt:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Gurt default and rebuild it.
# gurt:requires-sudo=true

sudo cp -r ~/.local/share/gurt/default/plymouth/* /usr/share/plymouth/themes/gurt/
sudo plymouth-set-default-theme gurt

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
