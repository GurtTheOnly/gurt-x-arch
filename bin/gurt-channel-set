#!/bin/bash

# gurt:summary=Set the Gurt channel, which dictates what git branch and package repository is used.
# gurt:args=<stable|rc|edge|dev>
# gurt:requires-sudo=true

if (($# == 0)); then
  echo "Usage: gurt-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") gurt-branch-set "master" && gurt-refresh-pacman "stable" ;;
"rc") gurt-branch-set "rc" && gurt-refresh-pacman "rc" ;;
"edge") gurt-branch-set "master" && gurt-refresh-pacman "edge" ;;
"dev") gurt-branch-set "dev" && gurt-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

gurt-update -y
