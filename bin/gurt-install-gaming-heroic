#!/bin/bash

# gurt:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# gurt:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
gurt-pkg-add heroic-games-launcher-bin
gurt-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
