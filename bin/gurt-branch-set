#!/bin/bash

# gurt:summary=Set the branch for Gurt's git repository.
# gurt:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: gurt-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $GURT_PATH switch $branch
