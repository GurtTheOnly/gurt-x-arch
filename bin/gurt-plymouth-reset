#!/bin/bash

# gurt:summary=Restore the default Gurt Plymouth boot theme and SDDM login screen
# gurt:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/gurt"

sudo find ~/.local/share/gurt/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme gurt

if gurt-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

gurt-refresh-sddm
