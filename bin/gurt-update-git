#!/bin/bash

# gurt:summary=Pull the latest Gurt git changes

set -e

echo -e "\e[32mUpdate Gurt\e[0m"

gurt-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C $GURT_PATH pull --autostash
git -C $GURT_PATH --no-pager diff --check || git -C $GURT_PATH reset --merge

hyprctl reload &>/dev/null || true
