#!/bin/bash

# gurt:summary=Lock the computer and turn off the display
# gurt:group=system
# gurt:name=lock
# gurt:examples=gurt system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    gurt-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.gurt.screensaver

if [[ ${GURT_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    gurt-brightness-keyboard off
    gurt-brightness-display off
  ) &
fi
