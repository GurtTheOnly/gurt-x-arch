#!/bin/bash

# gurt:summary=Reinstall all default Gurt packages from the stable channel
# gurt:requires-sudo=true

set -e

# Reinstall all default Gurt packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
gurt-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$GURT_PATH/install/gurt-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
