#!/bin/bash

# gurt:summary=Finish the installation of Gurt with items that can only be done after logging in.
# gurt:requires-sudo=true

set -e

FIRST_RUN_MODE=~/.local/state/gurt/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$GURT_PATH/install/first-run/battery-monitor.sh"
  bash "$GURT_PATH/install/first-run/recover-internal-monitor.sh"
  bash "$GURT_PATH/install/first-run/cleanup-reboot-sudoers.sh"
  bash "$GURT_PATH/install/first-run/firewall.sh"
  bash "$GURT_PATH/install/first-run/dns-resolver.sh"
  bash "$GURT_PATH/install/first-run/gnome-theme.sh"
  bash "$GURT_PATH/install/first-run/swayosd.sh"
  bash "$GURT_PATH/install/first-run/gtk-primary-paste.sh"
  bash "$GURT_PATH/install/first-run/elephant.sh"
  gurt-hook-install post-update "$GURT_PATH/install/first-run/install-voxtype.hook"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$GURT_PATH/install/first-run/welcome.sh"
  bash "$GURT_PATH/install/first-run/wifi.sh"
fi
